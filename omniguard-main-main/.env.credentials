# ==============================================================================
# OmniGuard Enterprise — Master Environment Configuration
# Paste your credentials here, then run: ./publish-all.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE (required for backend sync, dashboard, RBAC)
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Vite frontend also needs these (mirrored)
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# ------------------------------------------------------------------------------
# AI PROVIDERS — paste whichever you have; OmniGuard auto-selects
# ------------------------------------------------------------------------------

# Anthropic Claude (recommended)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI GPT-4 (fallback)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# Google Gemini (fallback)
# Get from: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# OpenRouter (proxy for multiple models)
# Get from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Ollama (fully local, no API key needed — just set the URL)
# Install: https://ollama.ai
# OLLAMA_BASE_URL=http://localhost:11434

# LiteLLM proxy (self-hosted)
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=sk-...

# ------------------------------------------------------------------------------
# NPM PUBLISHING (for: npm publish, omniguard CLI on npmjs)
# Get from: https://www.npmjs.com/settings/~/tokens
# ------------------------------------------------------------------------------
NPM_TOKEN=npm_...

# ------------------------------------------------------------------------------
# VS CODE EXTENSION PUBLISHING
# Get from: https://marketplace.visualstudio.com/manage → Personal Access Token
# Publisher name must match vscode-extension/package.json "publisher" field
# ------------------------------------------------------------------------------
VSCE_PAT=...
VSCE_PUBLISHER=omniguard

# ------------------------------------------------------------------------------
# DOCKER / CONTAINER REGISTRY
# For Docker Hub: docker login first, or set these for automated builds
# ------------------------------------------------------------------------------
DOCKER_USERNAME=omniguard
DOCKER_PASSWORD=...
DOCKER_IMAGE=omniguard/omniguard-enterprise

# ------------------------------------------------------------------------------
# AWS MARKETPLACE (optional — for marketplace listing)
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# INTEGRATIONS (optional — configure as needed)
# ------------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_...
# GITLAB_TOKEN=glpat-...
# JIRA_URL=https://yourorg.atlassian.net
# JIRA_EMAIL=you@yourorg.com
# JIRA_API_TOKEN=...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SERVICENOW_URL=https://yourinstance.service-now.com
# SERVICENOW_USER=...
# SERVICENOW_PASS=...

# ------------------------------------------------------------------------------
# DAEMON SETTINGS (defaults are fine for local dev)
# ------------------------------------------------------------------------------
OMNIGUARD_DAEMON_PORT=5175
OMNIGUARD_LOG_LEVEL=info
